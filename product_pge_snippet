/* ----- AJAX ثبت نظر ----- */
add_action('wp_ajax_ezp_submit_review', 'ezp_submit_review');
add_action('wp_ajax_nopriv_ezp_submit_review', 'ezp_submit_review');
function ezp_submit_review() {
    check_ajax_referer('ezp_review_nonce', 'nonce');

    // Honeypot
    if (!empty($_POST['ezp_hp'])) {
        wp_send_json_error(['message' => 'درخواست نامعتبر است.'], 400);
    }

    $product_id = absint($_POST['product_id'] ?? 0);
    $rating     = absint($_POST['rating'] ?? 0);
    $content    = isset($_POST['comment']) ? sanitize_textarea_field(wp_unslash($_POST['comment'])) : '';
    $author     = isset($_POST['author']) ? sanitize_text_field(wp_unslash($_POST['author'])) : '';
    $email      = isset($_POST['email']) ? sanitize_email(wp_unslash($_POST['email'])) : '';

    if (!$product_id || get_post_type($product_id) !== 'product') {
        wp_send_json_error(['message' => 'محصول نامعتبر است.']);
    }
    if ($rating < 1 || $rating > 5) {
        wp_send_json_error(['message' => 'لطفاً امتیاز ۱ تا ۵ را انتخاب کنید.']);
    }
    if (mb_strlen($content) < 5) {
        wp_send_json_error(['message' => 'متن نظر باید حداقل ۵ کاراکتر باشد.']);
    }

    if (is_user_logged_in()) {
        $user   = wp_get_current_user();
        $author = $user->display_name;
        $email  = $user->user_email;
        $uid    = $user->ID;
    } else {
        $uid = 0;
        if ($author === '' || $email === '' || !is_email($email)) {
            wp_send_json_error(['message' => 'نام و ایمیل معتبر الزامی است.']);
        }
    }

    // محدودیت تکرار ساده (همان ایمیل + همان محصول در ۲۴ ساعت)
    $recent = get_comments([
        'post_id'    => $product_id,
        'author_email' => $email,
        'number'     => 1,
        'date_query' => [['after' => '24 hours ago']],
        'status'     => 'all',
    ]);
    if (!empty($recent)) {
        wp_send_json_error(['message' => 'شما اخیراً برای این محصول نظر ثبت کرده‌اید. لطفاً بعداً تلاش کنید.']);
    }

    $approved = (is_user_logged_in() && current_user_can('moderate_comments')) ? 1 : 0;
    // اگر moderation فعال باشد، در انتظار تأیید
    if (get_option('comment_moderation') || get_option('comment_previously_approved') === '1') {
        // پیش‌فرض: اگر قبلاً تأیید شده، خودکار؛ وگرنه pending
        $approved = 0;
        if (is_user_logged_in()) {
            $prev = get_comments(['user_id' => $uid, 'status' => 'approve', 'number' => 1, 'count' => true]);
            if ($prev > 0 && !get_option('comment_moderation')) {
                $approved = 1;
            }
        }
    }

    $comment_id = wp_insert_comment([
        'comment_post_ID'      => $product_id,
        'comment_author'       => $author,
        'comment_author_email' => $email,
        'comment_content'      => $content,
        'comment_type'         => 'review',
        'comment_parent'       => 0,
        'user_id'              => $uid,
        'comment_approved'     => $approved ? 1 : 0,
        'comment_agent'        => substr(isset($_SERVER['HTTP_USER_AGENT']) ? sanitize_text_field(wp_unslash($_SERVER['HTTP_USER_AGENT'])) : '', 0, 200),
        'comment_author_IP'    => isset($_SERVER['REMOTE_ADDR']) ? sanitize_text_field(wp_unslash($_SERVER['REMOTE_ADDR'])) : '',
    ]);

    if (!$comment_id || is_wp_error($comment_id)) {
        wp_send_json_error(['message' => 'خطا در ثبت نظر. دوباره تلاش کنید.']);
    }

    update_comment_meta($comment_id, 'rating', $rating);

    // خریدار؟
    $is_buyer = false;
    if (function_exists('wc_customer_bought_product')) {
        $is_buyer = wc_customer_bought_product($email, $uid, $product_id);
    }
    update_comment_meta($comment_id, 'ezp_verified_buyer', $is_buyer ? '1' : '0');

    if (function_exists('wc_update_product_rating_counts')) {
        // به‌روزرسانی آمار امتیاز ووکامرس
        $product = wc_get_product($product_id);
        if ($product && $approved) {
            WC_Comments::clear_transients($product_id);
        }
    }

    $msg = $approved
        ? 'نظر شما با موفقیت ثبت شد.'
        : 'نظر شما ثبت شد و پس از تأیید نمایش داده می‌شود.';

    wp_send_json_success([
        'message'   => $msg,
        'approved'  => (bool) $approved,
        'is_buyer'  => $is_buyer,
    ]);
}

