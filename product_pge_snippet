.ezp-toast{
  background:#fff;border-radius:16px;padding:1.4rem 1.5rem;max-width:380px;width:100%;
  box-shadow:0 20px 50px rgba(0,0,0,.18);text-align:center;transform:translateY(12px);transition:transform .25s;
}
.ezp-toast-wrap.show .ezp-toast{transform:translateY(0)}
.ezp-toast .ico{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.ezp-toast.ok .ico{background:#ecfdf5;color:#059669}
.ezp-toast.err .ico{background:#fef2f2;color:#dc2626}
.ezp-toast .msg{font-size:.95rem;font-weight:600;color:var(--text);line-height:1.7;margin-bottom:1rem}
.ezp-toast .okbtn{
  background:var(--blue);color:#fff!important;border:none;border-radius:10px;padding:10px 22px;
  font-family:inherit;font-weight:700;font-size:.88rem;cursor:pointer;
}
