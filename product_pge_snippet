/* Popup toast */
.ezp-toast-wrap{position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,23,42,.45);opacity:0;visibility:hidden;transition:all .25s}
