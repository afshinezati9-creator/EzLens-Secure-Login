<script>
(function(){
  var root = document.querySelector('.ezp');
  if(!root) return;
  var ajaxUrl = <?php echo wp_json_encode($ajax_url); ?>;
  var nonce = <?php echo wp_json_encode($review_nonce); ?>;

  /* Gallery */
  var main = root.querySelector('#ezpMainImg');
  root.querySelectorAll('#ezpThumbs button').forEach(function(btn){
    btn.addEventListener('click', function(){
      root.querySelectorAll('#ezpThumbs button').forEach(function(b){ b.classList.remove('is-on'); });
      btn.classList.add('is-on');
      if(main) main.src = btn.getAttribute('data-src');
    });
  });

  /* Qty */
  var qty = root.querySelector('#ezpQty');
  var minus = root.querySelector('#ezpMinus');
  var plus = root.querySelector('#ezpPlus');
  if(qty && minus && plus){
    minus.addEventListener('click', function(){ qty.value = Math.max(1,(parseInt(qty.value,10)||1)-1); });
    plus.addEventListener('click', function(){ qty.value = Math.min(99,(parseInt(qty.value,10)||1)+1); });
  }

  /* Add to cart */
  var addBtn = root.querySelector('#ezpAddBtn');
  if(addBtn){
    addBtn.addEventListener('click', function(){
      var id = addBtn.getAttribute('data-product-id');
      var q = qty ? (parseInt(qty.value,10)||1) : 1;
      addBtn.disabled = true;
      addBtn.textContent = 'در حال افزودن...';
      var body = new URLSearchParams();
      body.append('product_id', id);
      body.append('quantity', q);
      fetch(<?php echo wp_json_encode(home_url('/?wc-ajax=add_to_cart')); ?>, {
        method:'POST', credentials:'same-origin',
        headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'},
        body: body.toString()
      }).then(function(r){ return r.json(); })
      .then(function(data){
        addBtn.disabled = false;
        addBtn.textContent = 'به سبد اضافه شد';
        setTimeout(function(){ addBtn.textContent = 'افزودن به سبد خرید'; }, 1800);
        if(window.jQuery){
          jQuery(document.body).trigger('added_to_cart', [data.fragments, data.cart_hash]);
          jQuery(document.body).trigger('wc_fragment_refresh');
        }
        document.body.dispatchEvent(new Event('added_to_cart'));
        showToast(true, 'محصول به سبد خرید اضافه شد.');
      }).catch(function(){
        addBtn.disabled = false;
        addBtn.textContent = 'افزودن به سبد خرید';
        window.location.href = addBtn.getAttribute('data-url');
      });
    });
  }

  /* Tabs */
  var navBtns = root.querySelectorAll('.ezp-tab-nav button');
  var panels = root.querySelectorAll('.ezp-tab-panel');
  function openTab(tab){
    navBtns.forEach(function(b){ b.classList.toggle('is-on', b.getAttribute('data-tab')===tab); });
    panels.forEach(function(p){ p.classList.toggle('is-on', p.id==='ezp-tab-'+tab); });
  }
  navBtns.forEach(function(btn){ btn.addEventListener('click', function(){ openTab(btn.getAttribute('data-tab')); }); });
  root.querySelectorAll('.ezp-goto-reviews').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault(); openTab('reviews');
      var t = root.querySelector('#ezpTabs');
      if(t) t.scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  /* Toast */
  var toast = document.getElementById('ezpToast');
  var toastBox = document.getElementById('ezpToastBox');
  var toastMsg = document.getElementById('ezpToastMsg');
  var toastIco = document.getElementById('ezpToastIco');
  function showToast(ok, msg){
    toastBox.className = 'ezp-toast ' + (ok ? 'ok' : 'err');
    toastIco.innerHTML = ok
      ? '<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>'
      : '<svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></svg>';
    toastMsg.textContent = msg;
    toast.classList.add('show');
  }
  document.getElementById('ezpToastClose').addEventListener('click', function(){ toast.classList.remove('show'); });
  toast.addEventListener('click', function(e){ if(e.target===toast) toast.classList.remove('show'); });

  /* Review AJAX */
  var form = document.getElementById('ezpReviewForm');
  if(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = document.getElementById('ezpRevSubmit');
      var ratingEl = form.querySelector('input[name="rating"]:checked');
      if(!ratingEl){ showToast(false, 'لطفاً امتیاز خود را انتخاب کنید.'); return; }
      var content = (form.querySelector('#ezpComment').value || '').trim();
      if(content.length < 5){ showToast(false, 'متن نظر باید حداقل ۵ کاراکتر باشد.'); return; }

      var fd = new FormData(form);
      fd.append('action', 'ezp_submit_review');
      fd.append('nonce', nonce);

      btn.disabled = true;
      btn.textContent = 'در حال ارسال...';

      fetch(ajaxUrl, { method:'POST', credentials:'same-origin', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(res){
          btn.disabled = false;
          btn.textContent = 'ارسال نظر';
          if(res.success){
            showToast(true, res.data.message || 'نظر شما ثبت شد.');
            form.reset();
          } else {
            showToast(false, (res.data && res.data.message) ? res.data.message : 'خطا در ثبت نظر.');
          }
        })
        .catch(function(){
          btn.disabled = false;
          btn.textContent = 'ارسال نظر';
          showToast(false, 'ارتباط برقرار نشد. دوباره تلاش کنید.');
        });
    });
  }
})();
</script>
