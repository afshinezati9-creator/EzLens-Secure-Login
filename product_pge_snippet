.ezp-star-select label{font-size:1.45rem;color:#cbd5e1;cursor:pointer;transition:color .15s;line-height:1}
.ezp-star-select input:checked ~ label,
.ezp-star-select label:hover,
.ezp-star-select label:hover ~ label{color:#fbbf24}
.ezp-hp{position:absolute;left:-9999px;opacity:0;height:0;width:0;overflow:hidden}
.ezp-rev-submit{
